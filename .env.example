# Gemini (AI Studio key). Without it, alerts go out unclassified.
GEMINI_API_KEY=

# ntfy. Without NTFY_TOPIC, alerts print to the console.
# Public ntfy.sh: use a long random topic (it acts as the password).
# Self-hosted with auth-default-access: deny-all: set NTFY_SERVER and NTFY_TOKEN (tk_...).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Optional dead-man's switch (e.g. a healthchecks.io ping URL), hit after every cycle.
HEARTBEAT_URL=

# Optional: folder for handing classified high-priority alerts to another process. Jobs are written
# to inbox/ as JSON; results that process writes to outbox/ are pushed as notifications.
HANDOFF_DIR=

JOBWATCH_DB=jobwatch.db
